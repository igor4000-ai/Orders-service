# Пример файла окружения. Скопируйте в .env и заполните значения:
#     cp .env.example .env
# Все параметры имеют безопасные значения по умолчанию для локальной
# разработки — .env обязателен только для продакшена и docker-compose.

# --- Django -------------------------------------------------------------
# Секретный ключ (ОБЯЗАТЕЛЬНО сменить в продакшене)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Europe/Moscow

# --- База данных ---------------------------------------------------------
# По умолчанию SQLite. Если задан POSTGRES_HOST — используется PostgreSQL
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- Email ---------------------------------------------------------------
# Консольный backend печатает письма в stdout (удобно при разработке).
# В docker-compose используется SMTP-ретранслятор MailHog.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@orders-service.local

# Email администратора сервиса: сюда отправляются накладные
# на исполнение заказов. Пусто — накладная не отправляется.
ADMIN_EMAIL=

# --- Celery --------------------------------------------------------------
# USE_CELERY=False — письма и импорт выполняются синхронно (без Redis).
# USE_CELERY=True  — задачи уходят в брокер и выполняются воркером
#                    (запуск: celery -A orders worker --loglevel=info).
USE_CELERY=False
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Прочее ---------------------------------------------------------------
# Максимум адресов доставки у одного пользователя (по описанию сервиса — 5)
MAX_USER_ADDRESSES=5
